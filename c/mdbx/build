#!/bin/bash
cd "${0%build}" || exit 1

cd src
# git checkout stable

C="
-fvisibility=hidden
-ffunction-sections
-fno-semantic-interposition
-Wl,-O1
-Wl,--gc-sections
-Wl,--allow-multiple-definition
"
[[ $DEBUG ]] && C="

"

BIN=../../../bin/${DEBUG:+debug/}
SO=${BIN}libmdbx.so
gcc -shared -o $SO mdbx.c \
	${DEBUG:+-g -O0} \
	${DEBUG:+-DMDBX_DEBUG=2} \
	-DLIBMDBX_EXPORTS=1 \
	-DMDBX_BUILD_SHARED_LIBRARY=1 \
	-DMDBX_BUILD_CXX=NO \
	-DMDBX_BUILD_FLAGS=\"\" \
	-DMDBX_BUILD_METADATA=\"\" \
	-fPIC -pthread \
	-Wl,-z,relro \
	-Wall -Werror -Wextra -Wpedantic \
	-Wno-error=attributes \
	-Wno-unused-command-line-argument \
	-Wno-tautological-compare \
	$C

gcc -o ${BIN}mdbx_copy mdbx_copy.c \
	${DEBUG:+-g -O0} \
	-L$BIN -Wl,-rpath,'$ORIGIN' -lmdbx -pthread \
	-Wall -Werror -Wextra -Wpedantic \
	-Wno-error=attributes \
	-Wno-unused-command-line-argument \
	-Wno-tautological-compare

[[ $DEBUG ]] || strip $SO ${BIN}mdbx_copy
