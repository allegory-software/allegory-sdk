#!/usr/bin/env python3
import re
import sys
from pathlib import Path

source = Path(sys.argv[1]) if len(sys.argv) > 1 else (
	Path(__file__).resolve().parent / 'www' / 'ui.js'
)
lines = source.read_text().splitlines()
sections = []

for line_i, line in enumerate(lines):
	if re.match(r'^\s*////', line):
		name = line.strip()[4:].split('-', 1)[0].strip()
		sections.append([name, line_i, 0])

for section_i, section in enumerate(sections):
	start_i = section[1] + 1
	if section_i + 1 < len(sections):
		end_i = sections[section_i + 1][1]
	else:
		end_i = len(lines)
	section[2] = sum(
		1 for line in lines[start_i:end_i]
		if line.strip() and not line.lstrip().startswith('//')
	)

section_width = max(20, max(len(section[0]) for section in sections))
print(f"{'Section':<{section_width}}  Code lines")
print(f"{'-' * section_width}  ----------")
for name, _, line_count in sorted(
	sections, key=lambda section: -section[2]
):
	print(f'{name:<{section_width}}  {line_count}')
